# vLLM Qwen3.6 lane for dual AMD Radeon AI PRO R9700 (gfx1201 / RDNA4).
# Issue devops#954.
#
# Base: kyuz0's prebuilt runtime image, PINNED BY DIGEST for reproducibility
# (kyuz0's own Dockerfile clones vLLM main unpinned; the digest freezes it).
#   vLLM   0.22.1rc1.dev499+g470229c37.d20260613  (commit 470229c37, 2026-06-13)
#   ROCm   7.14 nightly
#   Torch  2.13
#
# The base image ships upstream vLLM PR #42076 (Hopper/WGMMA layout change) which
# MIS-COMPILES the Gated-DeltaNet chunk_scaled_dot_kkt Triton kernel on gfx1201
# and deadlocks the TP>=2 profiling forward pass. Upstream fix is PR #46190
# (root-caused to #42076, still OPEN as of 2026-07-05). We vendor it here as a
# post-install patch. The gate is CUDA-neutral: current_platform.is_cuda() is
# True on NVIDIA (identical to stock), False on ROCm (pre-#42076 layout).
FROM docker.io/kyuz0/vllm-therock-gfx1201@sha256:55fa7796374a281e4b77a05cc2f26391d4100a5abb738f77c580ebc3951761e9

# Vendored patch: upstream vLLM PR #46190 — gate the WGMMA-layout tl.dot behind
# CAST_K_TRANS. Idempotent; fails the build loudly if any anchor drifts.
COPY <<'PYEOF' /tmp/patch_gdn_kkt.py
#!/usr/bin/env python3
"""Vendor upstream vLLM PR #46190 into the GDN chunk_scaled_dot_kkt kernel.

The #42076 Hopper WGMMA layout mis-compiles on ROCm/RDNA4 (gfx1201) and hangs
the TP>=2 profiling forward pass. This gates it behind CAST_K_TRANS, which is
current_platform.is_cuda() at launch: unchanged on NVIDIA, pre-#42076 layout on
ROCm. Idempotent. Issue devops#954."""
import ast
import os
import sys

import vllm

path = os.path.join(
    os.path.dirname(vllm.__file__),
    "model_executor/layers/fla/ops/chunk_scaled_dot_kkt.py",
)
src = open(path).read()

if "CAST_K_TRANS" in src:
    print(f"[patch_gdn_kkt] already patched, skipping: {path}")
    sys.exit(0)

edits = [
    # (a) import current_platform
    (
        "from vllm.triton_utils import tl, triton\n",
        "from vllm.triton_utils import tl, triton\n"
        "from vllm.platforms import current_platform\n",
    ),
    # (b) add constexpr param to the kernel signature
    (
        "    USE_G: tl.constexpr,\n):\n",
        "    USE_G: tl.constexpr,\n    CAST_K_TRANS: tl.constexpr,\n):\n",
    ),
    # (c) gate the WGMMA-layout tl.dot
    (
        "        b_A += tl.dot(b_kb, tl.trans(b_k).to(b_kb.dtype))\n",
        "        if CAST_K_TRANS:\n"
        "            # NVIDIA Hopper: WGMMA-aligned layout (vLLM PR #42076)\n"
        "            b_A += tl.dot(b_kb, tl.trans(b_k).to(b_kb.dtype))\n"
        "        else:\n"
        "            # ROCm/RDNA4 (gfx1201): pre-#42076 layout; WGMMA layout\n"
        "            # mis-compiles and deadlocks TP>=2 profiling (vLLM PR #46190)\n"
        "            b_A += tl.dot(b_kb.to(b_k.dtype), tl.trans(b_k))\n",
    ),
    # (d) pass CAST_K_TRANS at the kernel launch
    (
        "        K=K,\n        BT=BT,\n    )\n",
        "        K=K,\n        BT=BT,\n        CAST_K_TRANS=current_platform.is_cuda(),\n    )\n",
    ),
]

for i, (anchor, repl) in enumerate(edits):
    n = src.count(anchor)
    if n != 1:
        sys.exit(
            f"[patch_gdn_kkt] FATAL: edit {i} anchor matched {n} times "
            f"(expected 1) in {path}"
        )
    src = src.replace(anchor, repl)

ast.parse(src)  # reject the build if the patch produced invalid Python
open(path, "w").write(src)
print(f"[patch_gdn_kkt] applied vLLM PR #46190 CAST_K_TRANS gate to {path}")
PYEOF

RUN python3 /tmp/patch_gdn_kkt.py && \
    python3 -c "import ast, os, vllm; ast.parse(open(os.path.join(os.path.dirname(vllm.__file__), 'model_executor/layers/fla/ops/chunk_scaled_dot_kkt.py')).read()); print('[verify] chunk_scaled_dot_kkt.py parses clean')" && \
    grep -q 'CAST_K_TRANS' "$(python3 -c 'import os, vllm; print(os.path.join(os.path.dirname(vllm.__file__), "model_executor/layers/fla/ops/chunk_scaled_dot_kkt.py"))')"

# Vendored R9700 AITER runtime deltas distilled from andysalerno/r9700-serving.
# These keep broad AITER usable on gfx1201, disable the AITER sampler on gfx12x
# (its JIT path fails there), and fix the GDN/Mamba cache lookup used by MTP.
COPY <<'PYEOF' /tmp/patch_r9700_aiter.py
#!/usr/bin/env python3
"""Patch vLLM for R9700 AITER unified attention + Qwen3.6 MTP experiments.

The base image has the backend present, but only partially supports gfx1201:
is_aiter_found_and_supported() excludes gfx12x, broad AITER enables a sampler
JIT that fails on R9700, and the Mamba/GDN cache manager can drop the state
block during speculative decode cache lookup. Idempotent. Issue devops#954.
"""
import ast
import os
import sys

import vllm


ROOT = os.path.dirname(vllm.__file__)


def path(rel: str) -> str:
    return os.path.join(ROOT, rel)


def replace(rel: str, anchor: str, repl: str, marker: str | None = None) -> None:
    p = path(rel)
    src = open(p).read()
    if marker and marker in src:
        print(f"[patch_r9700_aiter] already patched marker={marker}: {rel}")
        return
    n = src.count(anchor)
    if n != 1:
        sys.exit(
            f"[patch_r9700_aiter] FATAL: {rel} anchor matched {n} times "
            f"(expected 1): {anchor!r}"
        )
    src = src.replace(anchor, repl)
    ast.parse(src)
    open(p, "w").write(src)
    print(f"[patch_r9700_aiter] patched {rel}")


replace(
    "_aiter_ops.py",
    "        from vllm.platforms.rocm import on_mi3xx\n\n        return on_mi3xx()\n",
    "        from vllm.platforms.rocm import on_gfx12x, on_mi3xx\n\n"
    "        return on_mi3xx() or on_gfx12x()\n",
    marker="return on_mi3xx() or on_gfx12x()",
)

replace(
    "_aiter_ops.py",
    "    @classmethod\n    @if_aiter_supported\n    def is_linear_enabled(cls) -> bool:\n",
    "    @classmethod\n"
    "    @if_aiter_supported\n"
    "    def is_sampler_enabled(cls) -> bool:\n"
    "        from vllm.platforms.rocm import on_mi3xx\n\n"
    "        # AITER's sampler JIT does not support gfx12x/RDNA4, even though\n"
    "        # other AITER paths such as unified attention can run there.\n"
    "        return cls._AITER_ENABLED and on_mi3xx()\n\n"
    "    @classmethod\n"
    "    @if_aiter_supported\n"
    "    def is_linear_enabled(cls) -> bool:\n",
    marker="def is_sampler_enabled",
)

replace(
    "v1/sample/ops/topk_topp_sampler.py",
    "            and rocm_aiter_ops.is_enabled()\n",
    "            and rocm_aiter_ops.is_sampler_enabled()\n",
    marker="rocm_aiter_ops.is_sampler_enabled()",
)

replace(
    "v1/core/single_type_kv_cache_manager.py",
    "        block_size = kv_cache_spec.block_size\n"
    "        max_num_blocks = max_length // block_size\n"
    "        # Search from right to left and early stop when a match is found.\n",
    "        block_size = kv_cache_spec.block_size\n"
    "        max_num_blocks = max_length // block_size\n"
    "        if drop_eagle_block and max_num_blocks > 0:\n"
    "            # Full-attention cache hit lookup matches one extra block and\n"
    "            # then drops that final block as it is only partially accepted.\n"
    "            # Mamba/GDN state blocks are [null, ..., state], so popping after\n"
    "            # a match removes the state. Search only up to the boundary.\n"
    "            max_num_blocks -= 1\n"
    "        # Search from right to left and early stop when a match is found.\n",
    marker="Mamba/GDN state blocks are [null, ..., state]",
)

replace(
    "v1/attention/backends/rocm_aiter_unified_attn.py",
    "        from aiter.ops.triton.unified_attention import unified_attention\n",
    "        from aiter.ops.triton.attention.unified_attention import unified_attention\n",
    marker="aiter.ops.triton.attention.unified_attention",
)

replace(
    "platforms/rocm.py",
    "        if rocm_aiter_ops.is_enabled() and on_gfx9():\n",
    "        if rocm_aiter_ops.is_mha_enabled() and (on_gfx9() or on_gfx12x()):\n",
    marker="rocm_aiter_ops.is_mha_enabled() and (on_gfx9() or on_gfx12x())",
)

replace(
    "v1/attention/backends/rocm_aiter_fa.py",
    "        from vllm.platforms.rocm import on_mi3xx\n\n"
    "        # DeviceCapability is currently created using torch.cuda.get_device_capability()\n"
    "        # which is known to be buggy on rocm systems. on_mi3xx uses amd-smi which is\n"
    "        # more reliable.\n"
    "        return on_mi3xx()\n",
    "        from vllm.platforms.rocm import on_gfx12x, on_mi3xx\n\n"
    "        # DeviceCapability is currently created using torch.cuda.get_device_capability()\n"
    "        # which is known to be buggy on rocm systems. These helpers use cached GCN\n"
    "        # arch state from ROCm, which is more reliable.\n"
    "        return on_mi3xx() or on_gfx12x()\n",
    marker="return on_mi3xx() or on_gfx12x()",
)

for rel in (
    "_aiter_ops.py",
    "platforms/rocm.py",
    "v1/attention/backends/rocm_aiter_fa.py",
    "v1/attention/backends/rocm_aiter_unified_attn.py",
    "v1/core/single_type_kv_cache_manager.py",
    "v1/sample/ops/topk_topp_sampler.py",
):
    ast.parse(open(path(rel)).read())

print("[patch_r9700_aiter] all patched files parse clean")
PYEOF

RUN python3 /tmp/patch_r9700_aiter.py && \
    grep -q 'def is_sampler_enabled' "$(python3 -c 'import os, vllm; print(os.path.join(os.path.dirname(vllm.__file__), "_aiter_ops.py"))')" && \
    grep -q 'Mamba/GDN state blocks' "$(python3 -c 'import os, vllm; print(os.path.join(os.path.dirname(vllm.__file__), "v1/core/single_type_kv_cache_manager.py"))')"
